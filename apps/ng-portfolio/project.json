{
  "name": "ng-portfolio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ng-portfolio/src",
  "prefix": "portfolio",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/ng-portfolio",
          "browser": ""
        },
        "index": "apps/ng-portfolio/src/index.html",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/ng-portfolio/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/ng-portfolio/src/favicon.png",
          "apps/ng-portfolio/src/assets"
        ],
        "styles": [
          "apps/ng-portfolio/src/styles/theme.scss",
          "apps/ng-portfolio/src/styles/styles.scss"
        ],
        "scripts": [],
        "browser": "apps/ng-portfolio/src/main.ts",
        "allowedCommonJsDependencies": ["imagekit-javascript"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/ng-portfolio/src/environments/environment.ts",
              "with": "apps/ng-portfolio/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "fileReplacements": [
            {
              "replace": "apps/ng-portfolio/src/environments/environment.ts",
              "with": "apps/ng-portfolio/src/environments/environment.dev.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "ng-portfolio:build:production"
        },
        "development": {
          "buildTarget": "ng-portfolio:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/ng-portfolio/proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "ng-portfolio:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/ng-portfolio/jest.config.ts"
      }
    }
  },
  "tags": []
}
